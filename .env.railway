# ============================================
# Open Trader - Environment Variables
# Railway Raw Env Vars Format
# Copy everything below this line
# ============================================

# Database (Railway auto-provisions this if you add PostgreSQL)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# AI Enhancement (Optional - Get from https://platform.moonshot.cn/)
# KIMI_API_KEY=your_kimi_api_key_here

# Telegram Alerts (Optional - Get from @BotFather)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Alerts (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Security
SECRET_KEY=change-this-to-a-random-string-in-production

# Debug Mode
DEBUG=false

# Server Port (Railway sets this automatically)
PORT=8000

# ============================================
# MINIMAL CONFIG (Copy only this if you want basic setup)
# ============================================

SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=false
PORT=8000

# ============================================
# FULL CONFIG WITH ALL FEATURES
# ============================================

# Database (Auto-set by Railway PostgreSQL addon)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# AI Agent Enhancement
KIMI_API_KEY=sk-your-kimi-api-key

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Security & Config
SECRET_KEY=your-super-secret-random-key-min-32-chars-long
DEBUG=false
PORT=8000
