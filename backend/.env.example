# Open Trader Configuration

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
SECRET_KEY=change-this-in-production-very-long-secret-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/paper_trading.db

# Market Data (Binance - free tier, no API key needed for public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Paper Trading
INITIAL_BALANCE_USD=10000
PAPER_TRADING_FEE=0.001  # 0.1% fee simulation

# Uniswap V3 (Fase 2 - Live Trading)
# ARBITRUM or BASE
CHAIN=arbitrum

# RPC URLs (use your own private RPC for production)
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org

# Wallet (Fase 2 - NUNCA commits estos valores)
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=

# Uniswap V3 Router & Factory (Arbitrum)
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984
UNISWAP_V3_QUOTER=0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6

# Trading Config
SLIPPAGE_TOLERANCE=0.005  # 0.5%
GAS_PRICE_MULTIPLIER=1.1
MAX_GAS_LIMIT=500000

# Risk Management
MAX_POSITION_SIZE_USD=1000
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.10
